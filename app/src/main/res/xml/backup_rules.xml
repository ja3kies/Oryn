<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (API < 31).
  Inclus : préférences utilisateur (thème, taille texte, position) + Reader datastore.
  Exclus : bibliothèque (fichiers EPUB copiés), covers, base Room
           (annotations, historique lecture, favoris, progression).
-->
<full-backup-content>
    <!-- Liste restrictive : les autres domaines/chemins restent exclus implicitement. -->
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore" />
</full-backup-content>
