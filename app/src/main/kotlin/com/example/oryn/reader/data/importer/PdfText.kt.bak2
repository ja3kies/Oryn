package com.example.oryn.reader.data.importer

import android.content.Context
import android.net.Uri
import android.util.LruCache
import com.tom_roush.pdfbox.android.PDFBoxResourceLoader
import com.tom_roush.pdfbox.pdmodel.PDDocument
import com.tom_roush.pdfbox.pdmodel.interactive.action.PDActionGoTo
import com.tom_roush.pdfbox.pdmodel.interactive.action.PDActionURI
import com.tom_roush.pdfbox.pdmodel.interactive.annotation.PDAnnotationLink
import com.tom_roush.pdfbox.pdmodel.interactive.documentnavigation.destination.PDDestination
import com.tom_roush.pdfbox.pdmodel.interactive.documentnavigation.destination.PDNamedDestination
import com.tom_roush.pdfbox.pdmodel.interactive.documentnavigation.destination.PDPageDestination
import com.tom_roush.pdfbox.pdmodel.interactive.documentnavigation.outline.PDOutlineItem
import com.tom_roush.pdfbox.pdmodel.interactive.documentnavigation.outline.PDOutlineNode
import com.tom_roush.pdfbox.text.PDFTextStripper
import com.tom_roush.pdfbox.text.TextPosition
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.io.File
import java.util.concurrent.locks.ReentrantLock
import kotlin.concurrent.withLock
import kotlin.math.max
import kotlin.math.min

/** Les annotations d'un PDF stockent « page × PDF_STRIDE + numéro de mot » dans startOffset / endOffset. */
const val PDF_STRIDE = 100_000

/** Mot d'une page PDF ; coordonnées normalisées (0..1), origine en haut à gauche de la page affichée. */
class PdfWord(
    val text: String,
    val l: Float, val t: Float, val r: Float, val b: Float,
    val size: Float = 0f,
    val bold: Boolean = false,
    val italic: Boolean = false
) {
    val width: Float get() = r - l
    val height: Float get() = b - t
}

/** Zone cliquable : adresse web ([uri]) ou page du même document ([page], -1 si absente). */
class PdfLink(val l: Float, val t: Float, val r: Float, val b: Float, val uri: String?, val page: Int)

class PdfTextPage(val words: List<PdfWord>, val links: List<PdfLink>) {
    companion object {
        val EMPTY = PdfTextPage(emptyList(), emptyList())
    }
}

/** Couche texte d'un PDF (PdfBox-Android) : mots positionnés, liens, sommaire. Ouverte à la demande. */
class PdfTextEngine(private val context: Context, private val uri: Uri) : AutoCloseable {
    private val lock = ReentrantLock()
    private val cache = LruCache<Int, PdfTextPage>(8)
    private var document: PDDocument? = null
    private var copy: File? = null
    private var closed = false
    private var outlineCache: List<TocEntry>? = null

    private fun open(): PDDocument? {
        document?.let { return it }
        if (closed) return null
        return runCatching {
            PDFBoxResourceLoader.init(context)
            // copie locale : PdfBox lit le fichier sans tout charger en mémoire
            val file = File(context.cacheDir, "oryn-text-${uri.toString().hashCode()}.pdf")
            context.contentResolver.openInputStream(uri)?.use { input ->
                file.outputStream().use { out -> input.copyTo(out) }
            } ?: return@runCatching null
            copy = file
            PDDocument.load(file)
        }.getOrNull().also { document = it }
    }

    suspend fun page(index: Int): PdfTextPage = withContext(Dispatchers.IO) {
        lock.withLock {
            cache.get(index)?.let { return@withLock it }
            val doc = open() ?: return@withLock PdfTextPage.EMPTY
            if (index !in 0 until doc.numberOfPages) return@withLock PdfTextPage.EMPTY
            val words = ArrayList<PdfWord>()
            runCatching {
                val stripper = WordCollector(words)
                stripper.startPage = index + 1
                stripper.endPage = index + 1
                stripper.getText(doc)
            }
            val links = runCatching { readLinks(doc, index) }.getOrDefault(emptyList())
            PdfTextPage(words, links).also { cache.put(index, it) }
        }
    }

    /** Sommaire du PDF (signets) ; [TocEntry.offset] = page × [PDF_STRIDE]. */
    suspend fun outline(): List<TocEntry> = withContext(Dispatchers.IO) {
        lock.withLock {
            outlineCache?.let { return@withLock it }
            val doc = open() ?: return@withLock emptyList()
            val out = ArrayList<TocEntry>()
            runCatching {
                val root = doc.documentCatalog.documentOutline
                if (root != null) walk(doc, root, 0, out)
            }
            out.also { outlineCache = it }
        }
    }

    private fun walk(doc: PDDocument, node: PDOutlineNode, level: Int, out: MutableList<TocEntry>) {
        var item: PDOutlineItem? = node.firstChild
        var guard = 0
        while (item != null && guard++ < 5_000) {
            val page = destPage(doc, item.destination ?: (item.action as? PDActionGoTo)?.destination)
            val title = item.title.orEmpty().trim()
            if (page >= 0 && title.isNotEmpty()) out.add(TocEntry(title, page * PDF_STRIDE, level))
            if (level < 4) walk(doc, item, level + 1, out)
            item = item.nextSibling
        }
    }

    private fun destPage(doc: PDDocument, dest: PDDestination?): Int = when (dest) {
        is PDPageDestination -> dest.retrievePageNumber()
        is PDNamedDestination -> runCatching {
            doc.documentCatalog.findNamedDestinationPage(dest)?.retrievePageNumber() ?: -1
        }.getOrDefault(-1)
        else -> -1
    }

    private fun readLinks(doc: PDDocument, index: Int): List<PdfLink> {
        val page = doc.getPage(index)
        if (page.rotation % 360 != 0) return emptyList()
        val crop = page.cropBox
        val w = crop.width
        val h = crop.height
        if (w <= 0f || h <= 0f) return emptyList()
        val out = ArrayList<PdfLink>()
        for (a in page.annotations) {
            if (a !is PDAnnotationLink) continue
            val r = a.rectangle ?: continue
            var url: String? = null
            var target = -1
            when (val action = a.action) {
                is PDActionURI -> url = action.uri
                is PDActionGoTo -> target = destPage(doc, action.destination)
                else -> Unit
            }
            if (url == null && target < 0) target = destPage(doc, a.destination)
            if (url == null && target < 0) continue
            out.add(
                PdfLink(
                    (r.lowerLeftX - crop.lowerLeftX) / w,
                    (crop.upperRightY - r.upperRightY) / h,
                    (r.upperRightX - crop.lowerLeftX) / w,
                    (crop.upperRightY - r.lowerLeftY) / h,
                    url,
                    target
                )
            )
        }
        return out
    }

    override fun close() {
        lock.withLock {
            if (closed) return
            closed = true
            cache.evictAll()
            runCatching { document?.close() }
            runCatching { copy?.delete() }
            document = null
        }
    }

    /** Reçoit le texte mot à mot (avec la position de chaque caractère) et en tire des rectangles. */
    private class WordCollector(private val out: MutableList<PdfWord>) : PDFTextStripper() {
        var pageW = 0f
        var pageH = 0f
        private val styleCache = HashMap<Any, Int>()

        init {
            sortByPosition = true
        }

        /** 1 = gras, 2 = italique (d'après le nom et le descripteur de la police). */
        private fun styleOf(tp: TextPosition): Int {
            val font = tp.font ?: return 0
            return styleCache.getOrPut(font) {
                val name = runCatching { font.name }.getOrNull()?.lowercase().orEmpty()
                var style = 0
                if (name.contains("bold") || name.contains("black") || name.contains("heavy") || name.contains("semibold") || name.contains("demi")) style = style or 1
                if (name.contains("italic") || name.contains("oblique") || name.contains("ital")) style = style or 2
                runCatching {
                    val fd = font.fontDescriptor
                    if (fd != null) {
                        if (fd.isForceBold || fd.fontWeight >= 600f) style = style or 1
                        if (fd.isItalic) style = style or 2
                    }
                }
                style
            }
        }

        override fun writeString(text: String, textPositions: MutableList<TextPosition>) {
            if (textPositions.isEmpty()) return
            val pw = textPositions[0].pageWidth
            val ph = textPositions[0].pageHeight
            if (pw <= 0f || ph <= 0f) return
            pageW = pw
            pageH = ph
            val sb = StringBuilder()
            var l = Float.MAX_VALUE
            var t = Float.MAX_VALUE
            var r = -Float.MAX_VALUE
            var b = -Float.MAX_VALUE
            var size = 0f
            var chars = 0
            var boldChars = 0
            var italicChars = 0

            fun flush() {
                val word = sb.toString().trim()
                if (word.isNotEmpty() && r > l) {
                    out.add(
                        PdfWord(
                            word,
                            (l / pw).coerceIn(0f, 1f), (t / ph).coerceIn(0f, 1f),
                            (r / pw).coerceIn(0f, 1f), (b / ph).coerceIn(0f, 1f),
                            size, boldChars * 2 > chars, italicChars * 2 > chars
                        )
                    )
                }
                sb.setLength(0)
                l = Float.MAX_VALUE; t = Float.MAX_VALUE; r = -Float.MAX_VALUE; b = -Float.MAX_VALUE
                size = 0f; chars = 0; boldChars = 0; italicChars = 0
            }

            for (tp in textPositions) {
                val u = tp.unicode ?: ""
                if (u.isBlank()) {
                    flush()
                    continue
                }
                sb.append(u)
                val h = tp.heightDir
                l = min(l, tp.xDirAdj)
                r = max(r, tp.xDirAdj + tp.widthDirAdj)
                t = min(t, tp.yDirAdj - h)
                b = max(b, tp.yDirAdj + h * 0.22f)
                chars++
                size = max(size, tp.fontSizeInPt)
                val style = styleOf(tp)
                if (style and 1 != 0) boldChars++
                if (style and 2 != 0) italicChars++
            }
            flush()
        }
    }
}

